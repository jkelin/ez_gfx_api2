# Copy this file to .env. mise loads it only for remote-test-* tasks.
# Hosts use SSH destination syntax. Paths use the remote POSIX shell's absolute syntax.
REMOTE_TEST_WINDOWS_HOST=developer@windows-host
REMOTE_TEST_WINDOWS_PATH=/cygdrive/c/remote-tests/ez-gfx-api2

REMOTE_TEST_LINUX_HOST=developer@linux-host
REMOTE_TEST_LINUX_PATH=/home/developer/remote-tests/ez-gfx-api2
# Set this when shader-slang cannot discover Slang; the diskstation commonly uses /usr.
REMOTE_TEST_LINUX_SLANG_DIR=/usr

REMOTE_TEST_MACOS_HOST=developer@macos-host
REMOTE_TEST_MACOS_PATH=/Users/developer/remote-tests/ez-gfx-api2

# Windows requires POSIX-capable rsync on both ends and a POSIX SSH shell where rsync and cargo are on PATH.
# Set to 1 only to validate local configuration without SSH or rsync network activity.
REMOTE_TEST_VALIDATE_ONLY=0
